# ─────────────────────────────────────────────────────────────────────
# USC landing — public site configuration
# ─────────────────────────────────────────────────────────────────────
# These VITE_* values are inlined into the built JS and are PUBLIC.
# Do NOT put real secrets (CRM API keys, passwords, tokens) here — those
# belong on a server / proxy, never in the client bundle.
#
# Setup:  cp .env.example .env   then fill in the real values.

# Phone numbers in international format (+380XXXXXXXXX). Display is derived.
VITE_PHONE_PRIMARY=+380963235506
VITE_PHONE_SECONDARY=+380504811035

# Public contact email
VITE_EMAIL=yskpro@ukr.net

# Social profile URLs (full https://...). Leave empty to hide the link/icon.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=

# Dealer-form endpoint — CRM webhook or a form service (e.g. Formspree).
# The form POSTs JSON: { name, company, email, phone, source, submittedAt }.
# Leave empty until the CRM is ready (the form then "succeeds" without sending).
VITE_FORM_ENDPOINT=
